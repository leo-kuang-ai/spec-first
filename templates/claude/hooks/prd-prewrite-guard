#!/bin/bash
set -euo pipefail

project_dir="${CLAUDE_PROJECT_DIR:-$(pwd)}"

node /dev/fd/3 "$project_dir" 3<<'EOF'
const fs = require('node:fs');
const path = require('node:path');

// 路口路由信号3 的 owner-owned gap 词表。与 check-prd-artifact.js:100 WHAT_TOUCHING_KEYWORDS
// 同步(冻结契约,扩展须两边同步 + 加 fixture)。限定扫 Outstanding Questions 区域 + frontmatter
// gap 字段,不扫 Requirements 正文(这些词在需求陈述里常见,全文扫会假阳使 final-prd 首次写几乎不可达)。
// 必须声明在调用 ownerOwnedGapKeywordHit 的顶层执行段之前,否则触发 const TDZ。
const WHAT_TOUCHING_KEYWORDS = [
  'interface', '接口', 'availability', '可用性', 'permission', '权限',
  'scope', '范围', 'source-of-truth', '数据权威', 'fallback', '降级',
  'analytics', '埋点', '指标',
];

const projectDir = process.argv[2];
const rawInput = readStdin();
const input = parseJsonObject(rawInput);
const toolName = String(input.tool_name || input.toolName || '');
const toolInput = input.tool_input && typeof input.tool_input === 'object' && !Array.isArray(input.tool_input)
  ? input.tool_input
  : {};

if (!['Write', 'Edit', 'MultiEdit'].includes(toolName)) {
  process.exit(0);
}

const targetPath = typeof toolInput.file_path === 'string' ? toolInput.file_path : '';
if (!targetPath) {
  process.exit(0);
}

const cwd = typeof input.cwd === 'string' && input.cwd ? input.cwd : projectDir;
const absoluteTarget = path.isAbsolute(targetPath)
  ? path.resolve(targetPath)
  : path.resolve(cwd, targetPath);
const normalizedRoot = path.resolve(projectDir);
if (!isWithinRoot(absoluteTarget, normalizedRoot)) {
  process.exit(0);
}

const relativeTarget = path.relative(normalizedRoot, absoluteTarget).split(path.sep).join('/');
if (!/^docs\/brainstorms\/.+-requirements\.md$/.test(relativeTarget)) {
  process.exit(0);
}

const mutation = buildCandidateContent(toolName, toolInput, absoluteTarget);
if (!mutation.currentContent && !mutation.candidateContent && mutation.mutatedFragments.length === 0) {
  process.exit(0);
}

const identityText = [mutation.candidateContent, mutation.currentContent].filter(Boolean).join('\n');
const prdIdentityPresent = isPrdRequirementsArtifact(identityText);
const readyOrReceiptSignal = hasReadyOrReceiptMutationSignal(
  [
    mutation.candidateContent,
    ...mutation.mutatedFragments,
  ].filter(Boolean).join('\n'),
);
if (!prdIdentityPresent && !readyOrReceiptSignal) {
  process.exit(0);
}

if (mutation.reconstructionDegraded) {
  if (hasReadyOrReceiptMutationSignal(mutation.mutatedFragments.join('\n'))) {
    const reasonLines = [
      `[spec-first] PRD prewrite guard blocked ${toolName}.`,
      `Target: ${relativeTarget}`,
      '',
      'The hook could not reconstruct the full candidate PRD content for this mutation, but the edit payload directly changes machine-owned ready/final receipt fields.',
      '`status: ready-for-planning`, `readiness_*` receipt fields, and the `write_mode=final-prd` + `can_enter_spec_plan=yes` ready pair are producer-owned. Do not write them through Claude file mutation tools.',
      'Run the producer-local finalize path instead: `node .claude/spec-first/workflows/spec-prd/scripts/finalize-prd-artifact.js docs/brainstorms/<slug>-requirements.md --inputs <input-path>`.',
      '',
      'reconstruction_status: degraded',
    ];
    block(reasonLines.join('\n'));
  }
  process.exit(0);
}

const content = mutation.candidateContent || '';
if (!content) {
  process.exit(0);
}

const readyStatus = /^\s*status:\s*ready-for-planning\s*$/im.test(content);
const machineReceipt = hasMachineReceiptField(content);
const firstWrite = !fs.existsSync(absoluteTarget);
const checkerReport = tryBuildCheckerReport(relativeTarget, content);
const checkerFacts = checkerReport ? checkerReport.facts : null;
const fallbackFacts = checkerFacts || buildFallbackFacts(content);
const readyIntent = fallbackFacts.ready_claim_present === true;
const hasDurableWriteMode = checkerFacts
  && typeof checkerFacts.write_mode === 'string'
  && checkerFacts.write_mode.length > 0
  && checkerFacts.write_mode !== 'not-run';
const hasFallbackDurableWriteMode = fallbackFacts.write_mode_declared_valid === true
  && fallbackFacts.write_mode !== 'not-run';
const missingWriteModeOnFirstWrite = firstWrite
  && (checkerFacts !== null ? !hasDurableWriteMode : !hasFallbackDurableWriteMode);

// 路口路由文案:首次写带"该 grill"信号却直写 final-prd → 已被 readyIntent 拦(Codex 全禁 final
// 首次写,因 checker 把 final-prd 当 claimsReady),此处只给命中信号的拦截加明确 grill 路由文案,
// 不改变"所有 final-prd 首次写被拦"的现有语义。信号只判结构,不判 grill 律是否真执行(R12 天花板)。
const hasDesignSignal = fallbackFacts.design_source_refs_present === true;
const multiSourceCount = countMultiSourceInputs(content);
const hasOwnerOwnedGap = ownerOwnedGapKeywordHit(content);
const hasOutstandingQuestions = fallbackFacts.outstanding_questions_present === true;
const hasGrillSignal = hasDesignSignal || multiSourceCount >= 2 || hasOwnerOwnedGap || hasOutstandingQuestions;
const finalPrdOnFirstWriteWithSignal = firstWrite
  && fallbackFacts.write_mode === 'final-prd'
  && hasGrillSignal;

if (readyStatus || machineReceipt || readyIntent || missingWriteModeOnFirstWrite) {
  const reasonLines = [
    `[spec-first] PRD prewrite guard blocked ${toolName}.`,
    `Target: ${relativeTarget}`,
    '',
    'A new PRD artifact must declare a durable-write path in `write_mode` before the first durable Write.',
    'A PRD artifact must not be written or mutated into ready/final state through Claude file mutation tools.',
    '`status: ready-for-planning` and `readiness_*` receipt fields are machine-owned; use the producer-local finalize path after the Requirements Grill and readiness lens pass.',
  ];
  if (finalPrdOnFirstWriteWithSignal) {
    reasonLines.push(
      '',
      'This first PRD write carries a grill signal — design source refs, multi-source inputs, an owner-owned gap, or outstanding questions are present.',
      '`final-prd` is never allowed on the first Write (it self-claims ready). Route into the Requirements Grill instead: `write_mode: ask-owner-first` to ask the next load-bearing owner question through the Interaction Method, or `write_mode: checkpoint-prd` with `can_enter_spec_plan: no` and `next_owner_question` to preserve recoverable context. `final-prd` is allowed only later, after every load-bearing branch reaches a Canonical stop point and no grill signal remains.',
    );
  }
  reasonLines.push(
    '',
    'Do not repair this by only changing enum values, deleting rich requirements, or rewriting the PRD into a checker-friendly skeleton.',
    'Run the `$spec-prd` pre-write Requirements Grill first, then choose the correct path: `ask-owner-first` to ask the next load-bearing owner question; `write_mode: checkpoint-prd` to preserve recoverable context with `can_enter_spec_plan: no` and `next_owner_question`; `route-out` when PRD authoring adds no durable WHAT value; or `final-prd` only after every load-bearing branch is closed.',
    'Legal enum values: write_mode = checkpoint-prd | final-prd | ask-owner-first | route-out; can_enter_spec_plan = yes | no; clarification_evidence = asked-owner | source-proven-no-ask | headless-degraded-logged; preflight_sweep_closure = closed | degraded | blocked.',
    'Phase 1 restore point: (1) emit a run-local Decision Card in the conversation with write_mode / highest_risk_gap / next_action / why planning will not invent WHAT; (2) emit the Requirement Analysis Gate map; (3) begin Requirements Grill before any durable Write — do not satisfy this gate by writing a ready/final PRD first and relying on Phase 4 to catch it.',
    'After all load-bearing branches are closed, update the existing artifact and run the producer-local finalize path. `status: ready-for-planning` and `readiness_verified_*` are machine-owned receipt fields.',
  );
  if (checkerFacts && Array.isArray(checkerFacts.blocking_reason_codes) && checkerFacts.blocking_reason_codes.length > 0) {
    reasonLines.push('', `checker_blocking_reason_codes: ${checkerFacts.blocking_reason_codes.join(', ')}`);
  }
  const remediationLines = formatRemediationHints(checkerReport);
  if (remediationLines.length > 0) {
    reasonLines.push('', 'checker_remediation_hints:', ...remediationLines);
  }
  reasonLines.push(
    '',
    'Write-before dry-run (recommended): pipe your draft through `node .claude/spec-first/workflows/spec-prd/scripts/check-prd-artifact.js docs/brainstorms/<slug>-requirements.md --stdin` BEFORE the durable Write to see ALL findings at once and fix them in one pass instead of one-per-Stop-hook-cycle.',
    '',
    'Compliant skeleton to copy verbatim (fill the angle-bracket placeholders, keep every token exact):',
    '```yaml',
    '---',
    'spec_id: <YYYY-MM-DD-NNN-slug>',
    'artifact_kind: prd-requirements',
    'target_surface: <App|H5/PC|Admin|Backend/Java|CLI/DevTool|Mixed|Generic>',
    '# status must remain draft until the producer-local finalize path writes the receipt.',
    'status: draft',
    'evidence_grade: mixed',
    'created: <YYYY-MM-DD>',
    '# HARD CONTRACT: Stop hook reads source_inputs; origin_doc/origin_docs are NOT recognized.',
    'source_inputs:',
    '  - <path/to/original-input.md>',
    '# Allowed write_mode values: checkpoint-prd | final-prd | ask-owner-first | route-out.',
    'write_mode: checkpoint-prd',
    '# Allowed can_enter_spec_plan values: yes | no.',
    'can_enter_spec_plan: no',
    'clarification_evidence: <asked-owner | source-proven-no-ask | headless-degraded-logged>',
    'preflight_sweep_closure: <closed | degraded | blocked>',
    'next_owner_question: <one load-bearing question or none>',
    '---',
    '',
    '## Summary',
    '## Change Delta',
    '## Requirements',
    '## Acceptance Examples',
    '## Scope Boundaries',
    '## Evidence And Assumptions',
    '',
    '## Outstanding Questions   # if present, use canonical headers (aliases include underscored forms):',
    '| id | question | prd write target | blocks_planning | closure_disposition | planning_would_invent_what | closure_state | recommended default |',
    '| --- | --- | --- | --- | --- | --- | --- | --- |',
    '',
    '## Owner Decision Trace    # required when any OQ uses owner-* disposition; bind each OQ by verbatim question or OQ-id:',
    '| question | owner_answer | chosen_answer | prd write target | consequence | closure_state |',
    '| --- | --- | --- | --- | --- | --- |',
    '```',
  );
  block(reasonLines.join('\n'));
}

process.exit(0);

function readStdin() {
  try {
    return fs.readFileSync(0, 'utf8');
  } catch {
    return '';
  }
}

function parseJsonObject(raw) {
  try {
    const parsed = JSON.parse(raw || '{}');
    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
  } catch {
    return {};
  }
}

function isWithinRoot(candidatePath, rootPath) {
  const relative = path.relative(rootPath, candidatePath);
  return relative === '' || (relative && !relative.startsWith('..') && !path.isAbsolute(relative));
}

// 信号2:source_inputs frontmatter 列表项数。≥2 项即多源信号(偏严,符合"尽可能澄清")。
function countMultiSourceInputs(text) {
  const lines = text.split(/\r?\n/);
  if (lines[0] !== '---') return 0;
  const fmEnd = lines.findIndex((line, i) => i > 0 && line === '---');
  if (fmEnd === -1) return 0;
  const fm = lines.slice(1, fmEnd);
  const start = fm.findIndex((line) => /^source_inputs:\s*$/.test(line));
  if (start === -1) return 0;
  let count = 0;
  for (let i = start + 1; i < fm.length; i += 1) {
    const line = fm[i];
    if (/^[A-Za-z0-9_-]+:\s*/.test(line)) break;
    if (/^\s*-\s+(.+?)\s*$/.test(line) || /^\s*path:\s+(.+?)\s*$/.test(line)) count += 1;
  }
  return count;
}

// 信号3:扫"模型自述未决区域"——Outstanding Questions section 文本 + frontmatter
// next_owner_question / highest_risk_gap 字段值。不扫 Requirements 正文(避免假阳)。
function ownerOwnedGapKeywordHit(text) {
  const lines = text.split(/\r?\n/);
  const candidates = [];

  // frontmatter gap 字段值
  if (lines[0] === '---') {
    const fmEnd = lines.findIndex((line, i) => i > 0 && line === '---');
    if (fmEnd !== -1) {
      const fm = lines.slice(1, fmEnd);
      for (const line of fm) {
        const m = line.match(/^\s*(next_owner_question|highest_risk_gap|preflight_sweep_closure)\s*:\s*(.*)$/i);
        if (m && m[2]) candidates.push(m[2]);
      }
    }
  }

  // Outstanding Questions section 文本(到下一个 ## 或文末)
  const oqStart = lines.findIndex((line) => /^##\s+Outstanding Questions/i.test(line));
  if (oqStart !== -1) {
    let end = lines.length;
    for (let i = oqStart + 1; i < lines.length; i += 1) {
      if (/^##\s/.test(lines[i])) { end = i; break; }
    }
    candidates.push(lines.slice(oqStart, end).join('\n'));
  }

  if (candidates.length === 0) return false;
  const lower = candidates.join('\n').toLowerCase();
  return WHAT_TOUCHING_KEYWORDS.some((kw) => lower.includes(kw.toLowerCase()));
}

function isPrdRequirementsArtifact(text) {
  return /^\s*artifact_kind:\s*prd-requirements\s*$/im.test(text);
}

function hasMachineReceiptField(text) {
  return /^\s*(?:readiness_verified_by|readiness_verified_at|readiness_checker_schema|readiness_finding_count|readiness_blocking_count|readiness_prd_hash|readiness_inputs_hash)\s*:/im.test(text);
}

function hasReadyOrReceiptMutationSignal(text) {
  if (!text) return false;
  if (/^\s*status:\s*ready-for-planning\s*$/im.test(text)) return true;
  if (hasMachineReceiptField(text)) return true;
  return extractDeclarationValue(text, 'write_mode', [
    'ask-owner-first', 'checkpoint-prd', 'final-prd', 'route-out', 'not-run',
  ]) === 'final-prd'
    || extractDeclarationValue(text, 'can_enter_spec[-_]?plan', ['yes', 'no']) === 'yes';
}

function buildFallbackFacts(text) {
  const writeMode = extractDeclarationValue(text, 'write_mode', [
    'ask-owner-first', 'checkpoint-prd', 'final-prd', 'route-out', 'not-run',
  ]);
  const canEnterSpecPlan = extractDeclarationValue(text, 'can_enter_spec[-_]?plan', ['yes', 'no']);
  return {
    write_mode: writeMode,
    write_mode_declared_valid: Boolean(writeMode),
    ready_claim_present: /^\s*status:\s*ready-for-planning\s*$/im.test(text)
      || writeMode === 'final-prd'
      || canEnterSpecPlan === 'yes',
    design_source_refs_present: detectDesignSourceRefs(text),
    outstanding_questions_present: /^##\s+Outstanding Questions/im.test(text),
  };
}

function extractDeclarationValue(text, fieldPattern, values) {
  const valuePattern = values.map(escapeRegExp).join('|');
  const regex = new RegExp(`^\\s*(?:[-*]\\s*)?${fieldPattern}\\s*:\\s*(${valuePattern})\\s*$`, 'im');
  const match = stripFencedCode(text).match(regex);
  return match ? match[1].trim() : null;
}

function stripFencedCode(text) {
  return String(text || '').replace(/```[\s\S]*?```/g, '');
}

function escapeRegExp(value) {
  return value.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&');
}

function detectDesignSourceRefs(text) {
  return /(?:figma\.com|mastergo\.com|js\.design|sketch\.cloud|axure|modao|摹客|蓝湖|lanhuapp|设计稿|design source|design link)/i.test(text);
}

function buildCandidateContent(currentToolName, currentToolInput, absolutePath) {
  if (currentToolName === 'Write') {
    const writeContent = typeof currentToolInput.content === 'string' ? currentToolInput.content : '';
    return {
      candidateContent: writeContent,
      currentContent: '',
      mutatedFragments: writeContent ? [writeContent] : [],
      reconstructionDegraded: false,
    };
  }

  const currentContent = readExistingFile(absolutePath);
  if (!currentContent) {
    return {
      candidateContent: '',
      currentContent: '',
      mutatedFragments: collectMutationFragments(currentToolName, currentToolInput),
      reconstructionDegraded: true,
    };
  }

  if (currentToolName === 'Edit') {
    const edit = normalizeEdit(currentToolInput);
    const fragments = edit ? [edit.newString] : collectMutationFragments(currentToolName, currentToolInput);
    const applied = edit ? applySingleEdit(currentContent, edit) : null;
    return {
      candidateContent: applied && applied.ok ? applied.text : '',
      currentContent,
      mutatedFragments: fragments,
      reconstructionDegraded: !applied || !applied.ok,
    };
  }

  if (currentToolName === 'MultiEdit') {
    const edits = Array.isArray(currentToolInput.edits)
      ? currentToolInput.edits.map(normalizeEdit).filter(Boolean)
      : [];
    let nextContent = currentContent;
    let degraded = edits.length === 0;

    for (const edit of edits) {
      const applied = applySingleEdit(nextContent, edit);
      if (!applied.ok) {
        degraded = true;
        break;
      }
      nextContent = applied.text;
    }

    return {
      candidateContent: degraded ? '' : nextContent,
      currentContent,
      mutatedFragments: edits.map((edit) => edit.newString),
      reconstructionDegraded: degraded,
    };
  }

  return {
    candidateContent: '',
    currentContent,
    mutatedFragments: collectMutationFragments(currentToolName, currentToolInput),
    reconstructionDegraded: true,
  };
}

function readExistingFile(absolutePath) {
  try {
    if (!fs.existsSync(absolutePath)) return '';
    return fs.readFileSync(absolutePath, 'utf8');
  } catch {
    return '';
  }
}

function normalizeEdit(value) {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
  if (typeof value.old_string !== 'string' || typeof value.new_string !== 'string') return null;
  if (value.old_string.length === 0) return null;
  return {
    oldString: value.old_string,
    newString: value.new_string,
    replaceAll: value.replace_all === true,
  };
}

function applySingleEdit(text, edit) {
  if (!text.includes(edit.oldString)) {
    return { ok: false, text };
  }
  if (edit.replaceAll) {
    return { ok: true, text: text.split(edit.oldString).join(edit.newString) };
  }
  return { ok: true, text: text.replace(edit.oldString, edit.newString) };
}

function collectMutationFragments(currentToolName, currentToolInput) {
  if (currentToolName === 'Write') {
    return typeof currentToolInput.content === 'string' ? [currentToolInput.content] : [];
  }
  if (currentToolName === 'Edit') {
    return typeof currentToolInput.new_string === 'string' ? [currentToolInput.new_string] : [];
  }
  if (currentToolName === 'MultiEdit' && Array.isArray(currentToolInput.edits)) {
    return currentToolInput.edits
      .map((entry) => (entry && typeof entry.new_string === 'string' ? entry.new_string : ''))
      .filter(Boolean);
  }
  return [];
}

function tryBuildCheckerReport(relativeTarget, content) {
  const checkerPath = path.join(
    normalizedRoot,
    '.claude',
    'spec-first',
    'workflows',
    'spec-prd',
    'scripts',
    'check-prd-artifact.js',
  );
  try {
    if (!fs.existsSync(checkerPath)) return null;
    // eslint-disable-next-line global-require, import/no-dynamic-require
    const { buildReport } = require(checkerPath);
    return buildReport(relativeTarget, content);
  } catch {
    return null;
  }
}

function formatRemediationHints(report) {
  if (!report || !Array.isArray(report.findings)) return [];
  return report.findings
    .filter((finding) => finding && (finding.expected_shape || finding.remediation_hint))
    .slice(0, 3)
    .map((finding) => {
      const parts = [`- ${finding.reason_code || 'unknown'}`];
      if (finding.expected_shape) parts.push(`expected: ${finding.expected_shape}`);
      if (finding.remediation_hint) parts.push(`fix: ${finding.remediation_hint}`);
      return parts.join(' | ');
    });
}

function block(reason) {
  process.stderr.write(`${reason}\n`);
  process.exit(2);
}
EOF
