#!/usr/bin/env node
'use strict';

// Cross-platform SessionStart hook. Claude Code invokes this in exec form
// (`node .claude/hooks/session-start`), so it runs identically on macOS, Linux, and Windows
// (with or without Git Bash) without relying on a POSIX shell, bash-only heredocs, or shell
// variable expansion. Exec form does not expand $CLAUDE_PROJECT_DIR, so the project dir is
// taken from the CLAUDE_PROJECT_DIR env var Claude exports, then argv[2] (legacy), then cwd
// (Claude runs the hook with cwd = project root).
const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');

const projectDir = resolveProjectDir();
const instructionPath = path.join(projectDir, 'CLAUDE.md');
const SPEC_FIRST_CLI_PATH = "__SPEC_FIRST_CLI_PATH__";
const LANG_START = '<!-- spec-first:lang:start -->';
const LANG_END = '<!-- spec-first:lang:end -->';
const LEGACY_BOOTSTRAP_START = '<!-- spec-first:bootstrap:start -->';
const LEGACY_BOOTSTRAP_END = '<!-- spec-first:bootstrap:end -->';
const missingMessage = [
  '[spec-first] using-spec-first SessionStart injection',
  'Managed language/governance block is missing from `CLAUDE.md`.',
  'Run `spec-first init` in this project and choose Claude Code when prompted to restore the managed language/governance block.',
].join('\n');

let additionalContext = missingMessage;
// Read via try/catch (not existsSync + read) so an unreadable file (EACCES/EISDIR)
// or a TOCTOU delete degrades to a pointer instead of throwing and aborting the hook.
const instructionBody = readInstructionBody(instructionPath);
if (instructionBody !== null) {
  const status = inspectWorkflowEntryGuidance(instructionBody);

  if (status.installed) {
    // The managed language/governance block already lives in CLAUDE.md, which Claude loads at
    // session start, so re-injecting its full body here would duplicate it verbatim.
    // Emit a short pointer instead: keep the workflow-entry trigger and the parent
    // multi-repo target_repo boundary salient without paying the duplication cost.
    additionalContext = [
      '[spec-first] using-spec-first SessionStart injection',
      "Workflow entry governance is active in this repo's CLAUDE.md (`spec-first:lang` managed block): route substantial work through a public spec-* workflow before non-trivial or risky edits, and in a parent multi-repo workspace keep writes within an explicit target_repo.",
      'Full routing policy: skills/using-spec-first/SKILL.md.',
    ].join('\n');
  } else {
    additionalContext = [
      '[spec-first] using-spec-first SessionStart injection',
      status.message,
      'Run `spec-first init` in this project and choose Claude Code when prompted to restore the managed language/governance block.',
    ].join('\n');
  }
}

const startupReminder = readStartupReminder(projectDir);
if (startupReminder) {
  additionalContext = [
    additionalContext,
    '',
    startupReminder,
  ].join('\n');
}

process.stdout.write(JSON.stringify({
  hookSpecificOutput: {
    hookEventName: 'SessionStart',
    additionalContext,
  },
}));

function resolveProjectDir() {
  const fromEnv = process.env.CLAUDE_PROJECT_DIR;
  if (typeof fromEnv === 'string' && fromEnv.trim()) {
    return fromEnv;
  }
  const fromArg = process.argv[2];
  if (typeof fromArg === 'string' && fromArg.trim() && fromArg !== '$CLAUDE_PROJECT_DIR') {
    return fromArg;
  }
  return process.cwd();
}

function readInstructionBody(filePath) {
  try {
    return fs.readFileSync(filePath, 'utf8');
  } catch {
    return null;
  }
}

function inspectWorkflowEntryGuidance(body) {
  const legacyStartIdx = body.indexOf(LEGACY_BOOTSTRAP_START);
  const legacyEndIdx = body.indexOf(LEGACY_BOOTSTRAP_END);
  if (legacyStartIdx !== -1 || legacyEndIdx !== -1) {
    if (legacyStartIdx === -1 || legacyEndIdx === -1 || legacyEndIdx <= legacyStartIdx) {
      return {
        installed: false,
        message: 'Legacy standalone bootstrap markers are incomplete in `CLAUDE.md`.',
      };
    }
    return {
      installed: false,
      message: 'Legacy standalone using-spec-first bootstrap should be merged into the `spec-first:lang` block in `CLAUDE.md`.',
    };
  }

  const langStartIdx = body.indexOf(LANG_START);
  const langEndIdx = body.indexOf(LANG_END);
  if (langStartIdx === -1 && langEndIdx === -1) {
    return {
      installed: false,
      message: 'Managed language/governance block is missing from `CLAUDE.md`.',
    };
  }
  if (langStartIdx === -1 || langEndIdx === -1 || langEndIdx <= langStartIdx) {
    return {
      installed: false,
      message: 'Managed language/governance markers are incomplete in `CLAUDE.md`.',
    };
  }

  const managedBlock = body.slice(langStartIdx, langEndIdx + LANG_END.length);
  if (managedBlock.includes('`using-spec-first`') &&
    managedBlock.includes('skills/using-spec-first/SKILL.md')) {
    return { installed: true };
  }
  return {
    installed: false,
    message: 'Workflow entry guidance is missing from the `spec-first:lang` block in `CLAUDE.md`.',
  };
}

function readStartupReminder(cwd) {
  try {
    if (!isTrustedSpecFirstCliPath(SPEC_FIRST_CLI_PATH)) {
      return '';
    }

    const result = spawnSync(process.execPath, [SPEC_FIRST_CLI_PATH, 'startup-reminder', '--claude'], {
      cwd,
      encoding: 'utf8',
      // Deliberate session-start latency cap. The child records its cooldown only after a
      // successful display, so on a dead/slow network it re-spawns every session — a larger
      // timeout would block every offline session-start by that much. The reminder is a
      // best-effort cosmetic notice and still completes on a healthy network (~600ms).
      timeout: 1200,
    });

    if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {
      return '';
    }

    return result.stdout.trim();
  } catch {
    return '';
  }
}

function isTrustedSpecFirstCliPath(cliPath) {
  if (
    typeof cliPath !== 'string'
    || cliPath.length === 0
    || cliPath === '__SPEC_FIRST_CLI_PATH__'
    || !path.isAbsolute(cliPath)
    || path.basename(cliPath) !== 'spec-first.js'
  ) {
    return false;
  }

  try {
    return fs.statSync(cliPath).isFile();
  } catch {
    return false;
  }
}
