#!/usr/bin/env node
'use strict';

const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');

const SPEC_FIRST_CLI_PATH = "__SPEC_FIRST_CLI_PATH__";
const LANG_START = '<!-- spec-first:lang:start -->';
const LANG_END = '<!-- spec-first:lang:end -->';

const projectDir = resolveProjectDir();
const instructionPath = path.join(projectDir, 'AGENTS.md');
let additionalContext = [
  '[spec-first] using-spec-first SessionStart injection',
  'Managed language/governance block is missing from `AGENTS.md`.',
  'Run `spec-first init --qoder` in this project after Qoder hook protocol support is confirmed.',
].join('\n');

const instructionBody = readInstructionBody(instructionPath);
if (instructionBody !== null) {
  const status = inspectWorkflowEntryGuidance(instructionBody);
  additionalContext = status.installed
    ? [
      '[spec-first] using-spec-first SessionStart injection',
      "Workflow entry governance is active in this repo's AGENTS.md (`spec-first:lang` managed block): route substantial work through a public spec-* workflow before non-trivial or risky edits, and in a parent multi-repo workspace keep writes within an explicit target_repo.",
      'Full routing policy: skills/using-spec-first/SKILL.md.',
    ].join('\n')
    : [
      '[spec-first] using-spec-first SessionStart injection',
      status.message,
      'Run `spec-first init --qoder` in this project after Qoder hook protocol support is confirmed.',
    ].join('\n');
}

const startupReminder = readStartupReminder(projectDir);
if (startupReminder) {
  additionalContext = [
    additionalContext,
    '',
    startupReminder,
  ].join('\n');
}

process.stdout.write(JSON.stringify({
  hookSpecificOutput: {
    hookEventName: 'SessionStart',
    additionalContext,
  },
}));

function resolveProjectDir() {
  const fromEnv = process.env.QODER_PROJECT_DIR;
  if (typeof fromEnv === 'string' && fromEnv.trim()) {
    return fromEnv;
  }

  const input = parseJsonObject(readStdin());
  if (typeof input.cwd === 'string' && input.cwd.trim()) {
    return input.cwd;
  }

  return process.cwd();
}

function readInstructionBody(filePath) {
  try {
    return fs.readFileSync(filePath, 'utf8');
  } catch {
    return null;
  }
}

function inspectWorkflowEntryGuidance(body) {
  const langStartIdx = body.indexOf(LANG_START);
  const langEndIdx = body.indexOf(LANG_END);
  if (langStartIdx === -1 && langEndIdx === -1) {
    return {
      installed: false,
      message: 'Managed language/governance block is missing from `AGENTS.md`.',
    };
  }
  if (langStartIdx === -1 || langEndIdx === -1 || langEndIdx <= langStartIdx) {
    return {
      installed: false,
      message: 'Managed language/governance markers are incomplete in `AGENTS.md`.',
    };
  }

  const managedBlock = body.slice(langStartIdx, langEndIdx + LANG_END.length);
  if (managedBlock.includes('`using-spec-first`') &&
    managedBlock.includes('skills/using-spec-first/SKILL.md')) {
    return { installed: true };
  }
  return {
    installed: false,
    message: 'Workflow entry guidance is missing from the `spec-first:lang` block in `AGENTS.md`.',
  };
}

function readStdin() {
  if (process.stdin.isTTY) {
    return '';
  }
  try {
    return fs.readFileSync(0, 'utf8');
  } catch {
    return '';
  }
}

function parseJsonObject(raw) {
  try {
    const parsed = JSON.parse(raw || '{}');
    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
  } catch {
    return {};
  }
}

function readStartupReminder(cwd) {
  try {
    if (!isTrustedSpecFirstCliPath(SPEC_FIRST_CLI_PATH)) {
      return '';
    }

    const result = spawnSync(process.execPath, [SPEC_FIRST_CLI_PATH, 'startup-reminder', '--qoder'], {
      cwd,
      encoding: 'utf8',
      timeout: 1200,
    });

    if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {
      return '';
    }

    return result.stdout.trim();
  } catch {
    return '';
  }
}

function isTrustedSpecFirstCliPath(cliPath) {
  if (
    typeof cliPath !== 'string'
    || cliPath.length === 0
    || cliPath === '__SPEC_FIRST_CLI_PATH__'
    || !path.isAbsolute(cliPath)
    || path.basename(cliPath) !== 'spec-first.js'
  ) {
    return false;
  }

  try {
    return fs.statSync(cliPath).isFile();
  } catch {
    return false;
  }
}
