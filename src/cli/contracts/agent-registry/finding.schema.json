{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/agent-registry/finding.schema.json",
  "title": "spec-first finding compatibility policy preview contract",
  "description": "Machine-readable contract for the cross-workflow Finding Core compatibility view. Workflow-native finding schemas remain authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_from",
    "boundary",
    "finding_core_fields",
    "preserve_native_fields",
    "adapter_policy",
    "evidence_policy"
  ],
  "properties": {
    "$schema": {
      "const": "../../../../src/cli/contracts/agent-registry/finding.schema.json"
    },
    "schema_version": {
      "type": "string"
    },
    "generated_from": {
      "const": "scripts/generate-ecc-governance-preview.js"
    },
    "boundary": {
      "const": "workflow_native_schema_wins"
    },
    "finding_core_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "preserve_native_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adapter_policy": {
      "type": "string",
      "minLength": 1
    },
    "evidence_policy": {
      "type": "string",
      "minLength": 1
    }
  }
}
