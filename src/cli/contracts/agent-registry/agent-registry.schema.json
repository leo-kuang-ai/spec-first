{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/agent-registry/agent-registry.schema.json",
  "title": "spec-first agent registry governance preview contract",
  "description": "Machine-readable contract for ECC-inspired agent registry preview artifacts. This contract validates source governance facts only and does not deliver runtime agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_from",
    "source_revision",
    "worktree_dirty",
    "stale_policy",
    "runtime_delivery",
    "entry_count",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "../../../../src/cli/contracts/agent-registry/agent-registry.schema.json"
    },
    "schema_version": {
      "type": "string"
    },
    "generated_from": {
      "const": "scripts/generate-ecc-governance-preview.js"
    },
    "source_revision": {
      "type": "string"
    },
    "worktree_dirty": {
      "type": "boolean"
    },
    "stale_policy": {
      "const": "source_wins_registry_is_preview_snapshot"
    },
    "runtime_delivery": {
      "const": "none_in_v1"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "canonical_id",
          "source_file",
          "origin",
          "pack",
          "packs",
          "priority",
          "overlap_status",
          "integration_action",
          "governance_state",
          "allowed_workflows",
          "trigger_signals",
          "required_inputs",
          "optional_inputs",
          "forbidden_actions",
          "output_schema",
          "no_pack_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_id": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "origin_aliases"
            ],
            "properties": {
              "source": {
                "enum": [
                  "spec-first-native",
                  "spec-first-native-or-ecc-inspired"
                ]
              },
              "origin_aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "pack": {
            "type": [
              "string",
              "null"
            ]
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "overlap_status": {
            "enum": [
              "direct_match",
              "partial_match",
              "spec_first_native",
              "missing_in_spec_first",
              "style_profile",
              "deprecated_candidate"
            ]
          },
          "integration_action": {
            "enum": [
              "keep_as_is",
              "enhance_existing",
              "merge",
              "split",
              "rename_generic",
              "optional_lens",
              "optional_profile",
              "deprecated",
              "inventory_only"
            ]
          },
          "governance_state": {
            "enum": [
              "inventory_only",
              "normalized",
              "routable",
              "schema_validated",
              "synthesis_ready",
              "deprecated"
            ]
          },
          "allowed_workflows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger_signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "optional_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "output_schema": {
            "type": "string",
            "minLength": 1
          },
          "no_pack_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
