      "properties": {
        "router_candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason_code",
            "candidate_count",
            "error"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "graph_expert_brief": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason_code",
            "readiness_status",
            "confidence",
            "error"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "readiness_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "standards_expert_brief": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason_code",
            "readiness_status",
            "confidence",
            "error"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "readiness_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "optional_pack_brief": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason_code",
            "activated_or_eligible_pack_count",
            "error"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "activated_or_eligible_pack_count": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "router_candidate_facts": {
      "type": [
        "object",
        "null"
      ]
    },
    "graph_expert_brief": {
      "type": [
        "object",
        "null"
      ]
    },
    "standards_expert_brief": {
      "type": [
        "object",
        "null"
      ]
    },
    "optional_pack_brief": {
      "type": [
        "object",
        "null"
      ]
    },
    "reviewer_candidate_guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "canonical_id",
          "priority",
          "reason_codes",
          "budget_hint",
          "candidate_only",
          "requires_skill_decision",
          "graph_context_available",
          "standards_context_available",
          "optional_context_available",
          "confidence_ceiling",
          "allowed_use",
          "required_disclosures",
          "fallback_guidance",
          "forbidden_claims"
