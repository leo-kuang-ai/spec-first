        "properties": {
          "agent_id": {
            "type": "string"
          },
          "canonical_id": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "budget_hint": {
            "enum": [
              "tiny",
              "small",
              "medium",
              "high"
            ]
          },
          "candidate_only": {
            "const": true
          },
          "requires_skill_decision": {
            "const": true
          },
          "graph_context_available": {
            "type": "boolean"
          },
          "standards_context_available": {
            "type": "boolean"
          },
          "optional_context_available": {
            "type": "boolean"
          },
          "confidence_ceiling": {
            "enum": [
              "unknown",
              "low",
              "medium",
              "high"
            ]
          },
          "allowed_use": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_disclosures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_guidance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
