        "requires_skill_decision": {
          "const": true
        },
        "requires_reviewer_selection_by_skill": {
          "const": true
        },
        "router_candidate_is_not_selection": {
          "const": true
        },
        "optional_candidate_is_not_activation": {
          "const": true
        },
        "component_failure_is_degraded_mode": {
          "const": true
        },
        "connector_queries_allowed": {
          "const": false
        },
        "runtime_delivery": {
          "const": "none_in_v9a"
        },
        "forbidden_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "degraded_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "reasons"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
