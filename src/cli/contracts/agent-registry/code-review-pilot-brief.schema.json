        "risk_signals",
        "enabled_packs",
        "enabled_agents",
        "evidence_types",
        "router_candidates_supplied",
        "allow_fallback_vocabulary"
      ],
      "properties": {
        "mode": {
          "enum": [
            "interactive",
            "autofix",
            "report-only",
            "headless"
          ]
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled_packs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled_agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "router_candidates_supplied": {
          "type": "boolean"
        },
        "allow_fallback_vocabulary": {
          "type": "boolean"
        }
      }
    },
    "component_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "router_candidates",
        "graph_expert_brief",
        "standards_expert_brief",
