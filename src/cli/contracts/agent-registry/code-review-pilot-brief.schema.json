{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/agent-registry/code-review-pilot-brief.schema.json",
  "title": "spec-first ECC code-review pilot brief",
  "description": "Read-only ECC governance pilot facts for spec-code-review. Candidate facts inform reviewer selection, but the skill remains responsible for selection, dispatch, synthesis, and final reports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from",
    "workflow",
    "source_artifacts",
    "input_summary",
    "component_status",
    "router_candidate_facts",
    "graph_expert_brief",
    "standards_expert_brief",
    "optional_pack_brief",
    "reviewer_candidate_guidance",
    "decision_boundary",
    "degraded_mode",
    "forbidden_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "spec-first.code-review-pilot-brief.v1"
    },
    "generated_from": {
      "const": "scripts/prepare-ecc-code-review-pilot-brief.js"
    },
    "workflow": {
      "const": "spec-code-review"
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "packs",
        "policy",
        "code_review_pilot_brief_schema",
        "router_candidate_schema",
        "graph_expert_brief_schema",
        "standards_expert_brief_schema",
        "optional_pack_brief_schema"
      ],
      "properties": {
        "registry": {
          "type": "string"
        },
        "packs": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "code_review_pilot_brief_schema": {
          "const": "src/cli/contracts/agent-registry/code-review-pilot-brief.schema.json"
        },
        "router_candidate_schema": {
          "const": "src/cli/contracts/agent-registry/router-candidate-output.schema.json"
        },
        "graph_expert_brief_schema": {
          "const": "src/cli/contracts/agent-registry/graph-expert-brief.schema.json"
        },
        "standards_expert_brief_schema": {
          "const": "src/cli/contracts/agent-registry/standards-expert-brief.schema.json"
        },
        "optional_pack_brief_schema": {
          "const": "src/cli/contracts/agent-registry/optional-pack-brief.schema.json"
        }
      }
    },
    "input_summary": {
