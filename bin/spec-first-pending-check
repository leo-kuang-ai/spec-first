#!/usr/bin/env bash
# spec-first-pending-check — return the first .pending-* marker path, if any
#
# Usage:
#   spec-first-pending-check
#
# Env overrides:
#   SPEC_FIRST_STATE_DIR  — override ~/.spec-first state directory
#   SPEC_FIRST_DIR        — override auto-detected spec-first root

set -uo pipefail

SPEC_FIRST_DIR="${SPEC_FIRST_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
STATE_DIR="${SPEC_FIRST_STATE_DIR:-$HOME/.spec-first}"
ANALYTICS_DIR="$STATE_DIR/analytics"

if [ ! -d "$ANALYTICS_DIR" ]; then
  exit 0
fi

find "$ANALYTICS_DIR" -maxdepth 1 -type f -name '.pending-*' -print -quit 2>/dev/null || true
