#!/usr/bin/env bash
# spec-first-review-read — read review log and config for dashboard
# Usage: spec-first-review-read
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval $("$SCRIPT_DIR/spec-first-slug" 2>/dev/null)
SPEC_FIRST_HOME="${SPEC_FIRST_HOME:-$HOME/.spec-first}"
cat "$SPEC_FIRST_HOME/projects/$SLUG/$BRANCH-reviews.jsonl" 2>/dev/null || echo "NO_REVIEWS"
echo "---CONFIG---"
"$SCRIPT_DIR/spec-first-config" get skip_eng_review 2>/dev/null || echo "false"
echo "---HEAD---"
git rev-parse --short HEAD 2>/dev/null || echo "unknown"
