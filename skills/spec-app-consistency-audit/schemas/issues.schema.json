{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/schemas/spec-app-consistency-audit/issues.schema.json",
  "title": "spec-app-consistency-audit issues artifact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "source_inputs",
    "consumers",
    "contract_status",
    "data_sensitivity",
    "issues",
    "rejected_issues"
  ],
  "properties": {
    "schema_version": { "const": "spec-app-consistency-audit-issues.v1" },
    "artifact_id": { "const": "issues" },
    "source_inputs": { "type": "array", "minItems": 1 },
    "consumers": { "type": "array", "minItems": 1 },
    "contract_status": { "const": "candidate" },
    "data_sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
    "issues": {
      "type": "array",
      "items": { "$ref": "issue.schema.json" }
    },
    "rejected_issues": {
      "type": "array",
      "items": { "$ref": "issue.schema.json" }
    },
    "semantic_adjudication_status": { "enum": ["not_run", "complete", "degraded", "invalid_isolation", "stale"] },
    "critical_obligations_processed": { "type": "boolean" },
    "adjudication_receipt": {
      "type": "object",
      "required": ["producer_kind", "generation_context_id", "adjudication_context_id", "context_isolation_status", "input_hashes", "excluded_inputs", "limitations"],
      "properties": {
        "producer_kind": { "const": "fresh_host_llm_adjudicator" },
        "generation_context_id": { "type": "string", "minLength": 1 },
        "adjudication_context_id": { "type": "string", "minLength": 1 },
        "context_isolation_status": { "enum": ["isolated", "unverified", "invalid"] },
        "input_hashes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "excluded_inputs": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
