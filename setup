#!/usr/bin/env bash
# spec-first setup — build browser binary + register skills with Claude Code / Codex
set -e

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: bun is required but not installed." >&2
  echo "Install it: curl -fsSL https://bun.sh/install | bash" >&2
  exit 1
fi

SPEC_FIRST_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$(dirname "$SPEC_FIRST_DIR")"
BROWSE_BIN="$SPEC_FIRST_DIR/browse/dist/browse"

IS_WINDOWS=0
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) IS_WINDOWS=1 ;;
esac

# ─── Parse flags ───────────────────────────────────────────────
HOST="claude"
LANG="zh"  # 默认中文
while [ $# -gt 0 ]; do
  case "$1" in
    --host) HOST="$2"; shift 2 ;;
    --host=*) HOST="${1#--host=}"; shift ;;
    --lang) LANG="$2"; shift 2 ;;
    --lang=*) LANG="${1#--lang=}"; shift ;;
    *) shift ;;
  esac
done

case "$HOST" in
  claude|codex|auto) ;;
  *) echo "Unknown --host value: $HOST (expected claude, codex, or auto)" >&2; exit 1 ;;
esac

case "$LANG" in
  zh|en) ;;
  *) echo "Unknown --lang value: $LANG (expected zh or en)" >&2; exit 1 ;;
esac

# For auto: detect which agents are installed
INSTALL_CLAUDE=0
INSTALL_CODEX=0
if [ "$HOST" = "auto" ]; then
  command -v claude >/dev/null 2>&1 && INSTALL_CLAUDE=1
  command -v codex >/dev/null 2>&1 && INSTALL_CODEX=1
  # If neither found, default to claude
  if [ "$INSTALL_CLAUDE" -eq 0 ] && [ "$INSTALL_CODEX" -eq 0 ]; then
    INSTALL_CLAUDE=1
  fi
elif [ "$HOST" = "claude" ]; then
  INSTALL_CLAUDE=1
elif [ "$HOST" = "codex" ]; then
  INSTALL_CODEX=1
fi

ensure_playwright_browser() {
  if [ "$IS_WINDOWS" -eq 1 ]; then
    # On Windows, Bun can't launch Chromium due to broken pipe handling
    # (oven-sh/bun#4253). Use Node.js to verify Chromium works instead.
    (
      cd "$SPEC_FIRST_DIR"
      node -e "const { chromium } = require('playwright'); (async () => { const b = await chromium.launch(); await b.close(); })()" 2>/dev/null
    )
  else
    (
      cd "$SPEC_FIRST_DIR"
      bun --eval 'import { chromium } from "playwright"; const browser = await chromium.launch(); await browser.close();'
    ) >/dev/null 2>&1
  fi
}

# 1. Build browse binary if needed (smart rebuild: stale sources, package.json, lock)
NEEDS_BUILD=0
if [ ! -x "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
elif [ -n "$(find "$SPEC_FIRST_DIR/browse/src" -type f -newer "$BROWSE_BIN" -print -quit 2>/dev/null)" ]; then
  NEEDS_BUILD=1
elif [ "$SPEC_FIRST_DIR/package.json" -nt "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
elif [ -f "$SPEC_FIRST_DIR/bun.lock" ] && [ "$SPEC_FIRST_DIR/bun.lock" -nt "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
fi

if [ "$NEEDS_BUILD" -eq 1 ]; then
  echo "Building browse binary..."
  (
    cd "$SPEC_FIRST_DIR"
    bun install
    bun run build
  )
  # Safety net: write .version if build script didn't (e.g., git not available during build)
  if [ ! -f "$SPEC_FIRST_DIR/browse/dist/.version" ]; then
    git -C "$SPEC_FIRST_DIR" rev-parse HEAD > "$SPEC_FIRST_DIR/browse/dist/.version" 2>/dev/null || true
  fi
fi

if [ ! -x "$BROWSE_BIN" ]; then
  echo "spec-first setup failed: browse binary missing at $BROWSE_BIN" >&2
  exit 1
fi

# 2. Ensure Playwright's Chromium is available
if ! ensure_playwright_browser; then
  echo "Installing Playwright Chromium..."
  (
    cd "$SPEC_FIRST_DIR"
    bunx playwright install chromium
  )

  if [ "$IS_WINDOWS" -eq 1 ]; then
    # On Windows, Node.js launches Chromium (not Bun — see oven-sh/bun#4253).
    # Ensure playwright is importable by Node from the spec-first directory.
    if ! command -v node >/dev/null 2>&1; then
      echo "spec-first setup failed: Node.js is required on Windows (Bun cannot launch Chromium due to a pipe bug)" >&2
      echo "  Install Node.js: https://nodejs.org/" >&2
      exit 1
    fi
    echo "Windows detected — verifying Node.js can load Playwright..."
    (
      cd "$SPEC_FIRST_DIR"
      # Bun's node_modules already has playwright; verify Node can require it
      node -e "require('playwright')" 2>/dev/null || npm install --no-save playwright
    )
  fi
fi

if ! ensure_playwright_browser; then
  if [ "$IS_WINDOWS" -eq 1 ]; then
    echo "spec-first setup failed: Playwright Chromium could not be launched via Node.js" >&2
    echo "  This is a known issue with Bun on Windows (oven-sh/bun#4253)." >&2
    echo "  Ensure Node.js is installed and 'node -e \"require('playwright')\"' works." >&2
  else
    echo "spec-first setup failed: Playwright Chromium could not be launched" >&2
  fi
  exit 1
fi

# 3. Ensure ~/.spec-first global state directory exists
mkdir -p "$HOME/.spec-first/projects"

# 3.5 Save language preference
echo "$LANG" > "$HOME/.spec-first/lang"

# ─── Helper: get skill description in current language ─────────────────────
get_skill_desc() {
  local skill="$1"
  local lang="$2"
  case "$skill" in
    benchmark)       [ "$lang" = "zh" ] && echo "性能回归检测" || echo "Performance regression testing" ;;
    browse)          [ "$lang" = "zh" ] && echo "浏览器自动化" || echo "Browser automation" ;;
    canary)          [ "$lang" = "zh" ] && echo "部署后监控" || echo "Post-deploy monitoring" ;;
    careful)         [ "$lang" = "zh" ] && echo "危险命令警告" || echo "Dangerous command warning" ;;
    codex)           [ "$lang" = "zh" ] && echo "Codex 集成" || echo "Codex integration" ;;
    design-consultation) [ "$lang" = "zh" ] && echo "设计咨询" || echo "Design consultation" ;;
    design-review)   [ "$lang" = "zh" ] && echo "设计审查" || echo "Design review" ;;
    document-release) [ "$lang" = "zh" ] && echo "文档更新" || echo "Document release" ;;
    focus-requirements) [ "$lang" = "zh" ] && echo "需求拆分" || echo "Focus requirements" ;;
    freeze)          [ "$lang" = "zh" ] && echo "冻结编辑范围" || echo "Freeze edit scope" ;;
    guard)           [ "$lang" = "zh" ] && echo "完整安全模式" || echo "Full security mode" ;;
    investigate)     [ "$lang" = "zh" ] && echo "系统化调试" || echo "Systematic debugging" ;;
    land-and-deploy) [ "$lang" = "zh" ] && echo "合并和部署" || echo "Land and deploy" ;;
    brainstorm)      [ "$lang" = "zh" ] && echo "头脑风暴" || echo "Brainstorm" ;;
    plan-ceo-review) [ "$lang" = "zh" ] && echo "CEO 审查" || echo "CEO review" ;;
    plan-design-review) [ "$lang" = "zh" ] && echo "设计审查" || echo "Design review" ;;
    plan-eng-review) [ "$lang" = "zh" ] && echo "工程审查" || echo "Engineering review" ;;
    qa-only)         [ "$lang" = "zh" ] && echo "仅 QA 报告" || echo "QA report only" ;;
    qa)              [ "$lang" = "zh" ] && echo "QA 测试修复" || echo "QA testing and fixes" ;;
    retro)           [ "$lang" = "zh" ] && echo "回顾总结" || echo "Retrospective" ;;
    review)          [ "$lang" = "zh" ] && echo "代码审查" || echo "Code review" ;;
    setup-browser-cookies) [ "$lang" = "zh" ] && echo "设置浏览器 Cookies" || echo "Setup browser cookies" ;;
    setup-deploy)    [ "$lang" = "zh" ] && echo "部署配置" || echo "Deploy setup" ;;
    ship)            [ "$lang" = "zh" ] && echo "发布流程" || echo "Ship workflow" ;;
    spec-first-upgrade) [ "$lang" = "zh" ] && echo "版本升级" || echo "Version upgrade" ;;
    unfreeze)        [ "$lang" = "zh" ] && echo "解冻编辑范围" || echo "Unfreeze edit scope" ;;
    spec-first)      [ "$lang" = "zh" ] && echo "主技能" || echo "Main skill" ;;
    *)               echo "$skill" ;;
  esac
}

# ─── Helper: link Claude skill subdirectories into a skills parent directory ──
link_claude_skill_dirs() {
  local spec_first_dir="$1"
  local skills_dir="$2"
  local linked=()
  for skill_dir in "$spec_first_dir"/*/; do
    if [ -f "$skill_dir/SKILL.md" ]; then
      skill_name="$(basename "$skill_dir")"
      # Skip node_modules
      [ "$skill_name" = "node_modules" ] && continue
      target="$skills_dir/$skill_name"
      # Create or update symlink; skip if a real file/directory exists
      if [ -L "$target" ] || [ ! -e "$target" ]; then
        ln -snf "spec-first/$skill_name" "$target"
        linked+=("$skill_name")
      fi
    fi
  done
  if [ ${#linked[@]} -gt 0 ]; then
    echo "  linked skills:"
    for s in "${linked[@]}"; do
      desc=$(get_skill_desc "$s" "$LANG")
      printf "    - %-24s %s\n" "$s" "$desc"
    done
  fi
}

# ─── Helper: link generated Codex skills into a skills parent directory ──
# Installs from .agents/skills/spec-first-* (the generated Codex-format skills)
# instead of source dirs (which have Claude paths).
link_codex_skill_dirs() {
  local spec_first_dir="$1"
  local skills_dir="$2"
  local agents_dir="$spec_first_dir/.agents/skills"
  local linked=()

  if [ ! -d "$agents_dir" ]; then
    echo "  warning: no .agents/skills/ directory found — run 'bun run build' first" >&2
    return 1
  fi

  for skill_dir in "$agents_dir"/spec-first*/; do
    if [ -f "$skill_dir/SKILL.md" ]; then
      skill_name="$(basename "$skill_dir")"
      target="$skills_dir/$skill_name"
      # Create or update symlink
      if [ -L "$target" ] || [ ! -e "$target" ]; then
        ln -snf "$skill_dir" "$target"
        linked+=("$skill_name")
      fi
    fi
  done
  if [ ${#linked[@]} -gt 0 ]; then
    echo "  linked skills:"
    for s in "${linked[@]}"; do
      # Strip spec-first- prefix for description lookup
      base_name="${s#spec-first-}"
      desc=$(get_skill_desc "$base_name" "$LANG")
      printf "    - %-28s %s\n" "$s" "$desc"
    done
  fi
}

# ─── Helper: create .agents/skills/spec-first/ sidecar symlinks ───────
# Codex/Gemini/Cursor read skills from .agents/skills/. We link runtime
# assets (bin/, browse/dist/, review/, qa/, etc.) so skill templates can
# resolve paths like $SKILL_ROOT/review/design-checklist.md.
create_agents_sidecar() {
  local repo_root="$1"
  local agents_spec_first="$repo_root/.agents/skills/spec-first"
  mkdir -p "$agents_spec_first"

  # Sidecar directories that skills reference at runtime
  for asset in bin browse review qa; do
    local src="$SPEC_FIRST_DIR/$asset"
    local dst="$agents_spec_first/$asset"
    if [ -d "$src" ] || [ -f "$src" ]; then
      if [ -L "$dst" ] || [ ! -e "$dst" ]; then
        ln -snf "$src" "$dst"
      fi
    fi
  done

  # Sidecar files that skills reference at runtime
  for file in ETHOS.md; do
    local src="$SPEC_FIRST_DIR/$file"
    local dst="$agents_spec_first/$file"
    if [ -f "$src" ]; then
      if [ -L "$dst" ] || [ ! -e "$dst" ]; then
        ln -snf "$src" "$dst"
      fi
    fi
  done
}

# 4. Install for Claude (default)
SKILLS_BASENAME="$(basename "$SKILLS_DIR")"
if [ "$INSTALL_CLAUDE" -eq 1 ]; then
  if [ "$SKILLS_BASENAME" = "skills" ]; then
    link_claude_skill_dirs "$SPEC_FIRST_DIR" "$SKILLS_DIR"
    echo "spec-first ready (claude)."
    echo "  lang: $LANG"
    echo "  browse: $BROWSE_BIN"
  else
    echo "spec-first ready (claude)."
    echo "  lang: $LANG"
    echo "  browse: $BROWSE_BIN"
    echo "  (skipped skill symlinks — not inside .claude/skills/)"
  fi
fi

# 5. Install for Codex
if [ "$INSTALL_CODEX" -eq 1 ]; then
  CODEX_SKILLS="$HOME/.codex/skills"
  CODEX_SPEC_FIRST="$CODEX_SKILLS/spec-first"
  mkdir -p "$CODEX_SKILLS"

  # Symlink spec-first source for runtime assets (bin/, browse/dist/)
  if [ -L "$CODEX_SPEC_FIRST" ] || [ ! -e "$CODEX_SPEC_FIRST" ]; then
    ln -snf "$SPEC_FIRST_DIR" "$CODEX_SPEC_FIRST"
  fi
  # Install generated Codex-format skills (not Claude source dirs)
  link_codex_skill_dirs "$SPEC_FIRST_DIR" "$CODEX_SKILLS"

  echo "spec-first ready (codex)."
  echo "  lang: $LANG"
  echo "  browse: $BROWSE_BIN"
  echo "  codex skills: $CODEX_SKILLS"
fi

# 6. Create .agents/ sidecar symlinks (useful for Codex/Gemini/Cursor workspace-local)
if [ "$INSTALL_CODEX" -eq 1 ]; then
  # Detect repo root: if we're inside a skills directory, go up two levels
  if [ "$SKILLS_BASENAME" = "skills" ]; then
    REPO_ROOT="$(dirname "$SKILLS_DIR")"
  else
    REPO_ROOT="$SPEC_FIRST_DIR"
  fi
  create_agents_sidecar "$REPO_ROOT"
fi

# 7. First-time welcome + legacy cleanup
if [ ! -d "$HOME/.spec-first" ]; then
  mkdir -p "$HOME/.spec-first"
  echo "  Welcome! Run /spec-first-upgrade anytime to stay current."
fi
rm -f /tmp/spec-first-latest-version
