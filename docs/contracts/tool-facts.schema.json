{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "repo_root",
    "items",
    "configured_dependencies",
    "schema_capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "tool-facts.v2"
    },
    "generated_at": {
      "type": "string"
    },
    "repo_root": {
      "type": "string"
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "enum": [
        "minimal",
        "recommended",
        "platform"
      ]
    },
    "tools": {
      "type": "object",
      "additionalProperties": true
    },
    "helper_tools": {
      "type": "object",
      "additionalProperties": true
    },
    "provider_readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "configured_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configuredDependency"
      }
    },
    "schema_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "source_snapshot": {
      "$ref": "#/$defs/sourceSnapshot"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "profile",
        "required",
        "baseline_blocking",
        "dependency_status",
        "configured_status",
        "result",
        "reason_code",
        "installed",
        "missing_dependency_reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "profile": {
          "enum": [
            "minimal",
            "recommended",
            "platform"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "baseline_blocking": {
          "type": "boolean"
        },
        "dependency_status": {
          "type": "string"
        },
        "configured_status": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "installed": {
          "type": "boolean"
        },
        "missing_dependency_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": "string"
        },
        "capability_status": {
          "type": "string"
        },
        "execution_readiness": {
          "type": "string"
        },
        "conformance_status": {
          "type": "string"
        },
        "repair_scope": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": true
        },
        "provider_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "demand": {
          "type": "object",
          "required": [
            "blocking",
            "demand_source",
            "matched_rule",
            "reason_code",
            "migration_warning"
          ],
          "additionalProperties": false,
          "properties": {
            "blocking": {
              "type": "boolean"
            },
            "demand_source": {
              "enum": [
                "explicit-selection",
                "workflow",
                "baseline",
                "legacy",
                "not-requested"
              ]
            },
            "matched_rule": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason_code": {
              "enum": [
                "capability-required-for-scope",
                "capability-not-requested"
              ]
            },
            "migration_warning": {
              "enum": [
                null,
                "legacy-readiness-policy"
              ]
            }
          }
        },
        "dependency_identity": {
          "$ref": "#/$defs/npmArchiveIdentity"
        }
      },
      "additionalProperties": true
    },
    "configuredDependency": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source_path",
        "command",
        "args_shape",
        "declared_tool_id",
        "declared_status",
        "dependency_status",
        "configured_status",
        "result",
        "reason_code"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args_shape": {
          "type": "string"
        },
        "declared_tool_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_status": {
          "type": "string"
        },
        "dependency_status": {
          "type": "string"
        },
        "configured_status": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "setup-source-snapshot.v1"
        },
        "registry_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "host_config_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_head": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "repo_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "invalidation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "npmArchiveIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "source",
        "integrity",
        "installer",
        "integrity_status",
        "verification_scope"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
        },
        "installer": {
          "const": "npm-pack+npx"
        },
        "integrity_status": {
          "const": "verified"
        },
        "verification_scope": {
          "const": "top-level-package-archive"
        }
      }
    }
  }
}
