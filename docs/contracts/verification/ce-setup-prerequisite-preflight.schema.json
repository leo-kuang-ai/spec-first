{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/ce-setup-prerequisite-preflight/v1",
  "title": "CE setup localization prerequisite preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "producer",
    "source_snapshot",
    "public_entrypoint_disposition",
    "contracts",
    "consumer_inventory",
    "overall_status",
    "blocking_reason_codes",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "ce-setup-prerequisite-preflight/v1" },
    "artifact_kind": { "const": "source-bound-contract-preflight" },
    "producer": { "const": "scripts/check-ce-localization-review.cjs" },
    "source_snapshot": {
      "$ref": "https://spec-first.dev/contracts/ce-setup-snapshot/v1"
    },
    "public_entrypoint_disposition": { "const": "reuse-spec-runtime-setup-only" },
    "contracts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/contract" }
    },
    "consumer_inventory": { "$ref": "#/$defs/consumerInventory" },
    "overall_status": { "enum": ["confirmed", "degraded", "blocked"] },
    "blocking_reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "claim_ceiling": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "status",
        "reason_code",
        "owner",
        "source_refs",
        "test_refs",
        "next_action",
        "status_authority"
      ],
      "properties": {
        "contract_id": {
          "enum": [
            "mode-side-effect",
            "source-snapshot",
            "project-config-validity",
            "runtime-status-projection",
            "host-invocation-receipt",
            "consumer-inventory"
          ]
        },
        "status": { "enum": ["confirmed", "partial", "degraded", "blocked"] },
        "reason_code": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "test_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "next_action": { "type": "string", "minLength": 1 },
        "status_authority": {
          "enum": ["deterministic-source-check", "plan-settled", "plan-settled-and-source-checked"]
        }
      }
    },
    "consumerInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "rows",
        "missing_keys",
        "global_readiness_gate",
        "claim_ceiling"
      ],
      "properties": {
        "schema_version": { "const": "ce-setup-config-consumer-inventory/v1" },
        "status": { "enum": ["confirmed", "partial"] },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumerRow" }
        },
        "missing_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "global_readiness_gate": { "const": false },
        "claim_ceiling": { "type": "string", "minLength": 1 }
      }
    },
    "consumerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "consumer_kind",
        "owner",
        "source_ref",
        "source_line",
        "source_excerpt",
        "fallback_boundary",
        "blocking_scope",
        "setup_facts_consumer"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "consumer_kind": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_line": { "type": "integer", "minimum": 1 },
        "source_excerpt": { "type": "string", "minLength": 1 },
        "fallback_boundary": { "const": "consumer-owned" },
        "blocking_scope": { "const": "consumer-local-only" },
        "setup_facts_consumer": { "type": "boolean" }
      }
    }
  }
}
