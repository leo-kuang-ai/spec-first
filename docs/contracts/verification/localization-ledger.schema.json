{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/ce-localization-ledger/v1",
  "title": "CE to spec-first localization semantic adjudication ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "producer",
    "single_writer",
    "source_snapshot",
    "inventory_ref",
    "inventory_sha256",
    "scenarios_ref",
    "scenarios_sha256",
    "upstream_adjudication_ref",
    "upstream_adjudication_sha256",
    "entries",
    "consumers",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "ce-localization-ledger/v1" },
    "artifact_kind": { "const": "source-bound-semantic-adjudication-ledger" },
    "producer": { "const": "spec-work-semantic-adjudication-owner" },
    "single_writer": { "const": "ce-localization-ledger-writer" },
    "source_snapshot": { "$ref": "https://spec-first.dev/contracts/ce-setup-snapshot/v1" },
    "inventory_ref": { "type": "string", "minLength": 1 },
    "inventory_sha256": { "$ref": "#/$defs/sha256" },
    "scenarios_ref": { "type": "string", "minLength": 1 },
    "scenarios_sha256": { "$ref": "#/$defs/sha256" },
    "upstream_adjudication_ref": { "type": "string", "minLength": 1 },
    "upstream_adjudication_sha256": { "$ref": "#/$defs/sha256" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "consumers": { "$ref": "#/$defs/nonEmptyStrings" },
    "claim_ceiling": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence_refs", "limitations"],
      "properties": {
        "state": { "enum": ["confirmed", "partial", "degraded", "not-run", "exploratory"] },
        "evidence_refs": { "$ref": "#/$defs/strings" },
        "limitations": { "$ref": "#/$defs/strings" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_id",
        "ce_relation",
        "ce_record_id",
        "ce_path",
        "target_repo",
        "target_repo_head",
        "source_tree_hash",
        "inventory_hash",
        "scenario_id",
        "scenario_kind",
        "visibility",
        "primary_user_tasks",
        "actors",
        "actor_outcomes",
        "canonical_owner",
        "evidence_owner",
        "source_refs",
        "test_refs",
        "evidence_role",
        "ce_behavior_intent",
        "localization_disposition",
        "architecture_posture",
        "implementation_unit",
        "implementation_targets",
        "target_action",
        "product_contract_refs",
        "requirement_refs",
        "acceptance_example_refs",
        "expected_rnd_gain",
        "adjudication_status",
        "baseline_ref",
        "improvement_contract_hash",
        "preserved_behavior",
        "intentionally_rejected_behavior",
        "new_local_behavior",
        "downstream_consumers",
        "handoff_contract_refs",
        "setup_dependency_refs",
        "setup_dependency_status",
        "complexity_cost",
        "structure_contract",
        "behavior_quality",
        "runtime_cost",
        "field_outcome",
        "evidence_refs",
        "limitations",
        "reassessment_trigger",
        "final_status"
      ],
      "properties": {
        "ledger_id": { "type": "string", "pattern": "^LOC-[A-Z0-9-]+$" },
        "ce_relation": { "enum": ["upstream", "local-only"] },
        "ce_record_id": { "type": ["string", "null"] },
        "ce_path": { "type": ["string", "null"] },
        "target_repo": { "type": "string", "minLength": 1 },
        "target_repo_head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "source_tree_hash": { "$ref": "#/$defs/sha256" },
        "inventory_hash": { "$ref": "#/$defs/sha256" },
        "scenario_id": { "type": "string", "pattern": "^SCN-[A-Z0-9-]+$" },
        "scenario_kind": { "enum": ["user-facing", "workflow-orchestrator", "internal-helper", "side-effect", "router", "provider-adapter", "local-only"] },
        "visibility": { "enum": ["public", "internal", "evidence-only"] },
        "primary_user_tasks": { "$ref": "#/$defs/nonEmptyStrings" },
        "actors": { "$ref": "#/$defs/nonEmptyStrings" },
        "actor_outcomes": { "$ref": "#/$defs/nonEmptyStrings" },
        "canonical_owner": { "type": "string", "minLength": 1 },
        "evidence_owner": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "test_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidence_role": { "enum": ["upstream-fact", "local-contract", "behavior-eval", "field-outcome"] },
        "ce_behavior_intent": { "$ref": "#/$defs/nonEmptyStrings" },
        "localization_disposition": { "enum": ["reuse", "extend", "compose", "evidence-only", "reject", "defer"] },
        "architecture_posture": { "enum": ["reuse", "extend", "compose", "new-approved", "not-applicable"] },
        "implementation_unit": { "type": "string", "minLength": 1 },
        "implementation_targets": { "$ref": "#/$defs/strings" },
        "target_action": { "type": "string", "minLength": 1 },
        "product_contract_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "requirement_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "acceptance_example_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "expected_rnd_gain": { "type": "string", "minLength": 1 },
        "adjudication_status": { "enum": ["proposed", "confirmed", "rejected", "deferred", "invalidated"] },
        "baseline_ref": { "type": "string", "minLength": 1 },
        "improvement_contract_hash": { "$ref": "#/$defs/sha256" },
        "preserved_behavior": { "$ref": "#/$defs/strings" },
        "intentionally_rejected_behavior": { "$ref": "#/$defs/strings" },
        "new_local_behavior": { "$ref": "#/$defs/strings" },
        "downstream_consumers": { "$ref": "#/$defs/strings" },
        "handoff_contract_refs": { "$ref": "#/$defs/strings" },
        "setup_dependency_refs": { "$ref": "#/$defs/strings" },
        "setup_dependency_status": { "enum": ["not-applicable", "pending", "confirmed", "degraded", "blocked"] },
        "complexity_cost": { "type": "string", "minLength": 1 },
        "structure_contract": { "$ref": "#/$defs/dimension" },
        "behavior_quality": { "$ref": "#/$defs/dimension" },
        "runtime_cost": { "$ref": "#/$defs/dimension" },
        "field_outcome": { "$ref": "#/$defs/dimension" },
        "evidence_refs": { "$ref": "#/$defs/strings" },
        "limitations": { "$ref": "#/$defs/strings" },
        "reassessment_trigger": { "$ref": "#/$defs/nonEmptyStrings" },
        "final_status": { "enum": ["confirmed-improved", "maintained-confirmed", "mechanism-improved", "degraded-or-partial", "not-improved-or-rejected"] }
      }
    }
  }
}
