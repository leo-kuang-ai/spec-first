{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/ce-upstream-adjudication-input/v1",
  "title": "CE upstream adjudication input",
  "type": "object",
  "required": ["schema_version", "producer", "join_key", "upstream", "target_source_snapshot", "deterministic_facts", "records"],
  "properties": {
    "schema_version": { "const": "ce-upstream-adjudication-input/v1" },
    "producer": { "$ref": "#/$defs/producer" },
    "join_key": { "const": "path+upstream+target-source" },
    "upstream": { "$ref": "#/$defs/upstream" },
    "target_source_snapshot": { "$ref": "#/$defs/targetSourceSnapshot" },
    "deterministic_facts": { "type": "object" },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inputRecord" } },
    "semantic_decisions": { "const": "omitted: produced only by the authorized adjudication producer" }
  },
  "additionalProperties": false,
  "$defs": {
    "producer": {
      "type": "object",
      "required": ["kind", "version", "status"],
      "properties": { "kind": { "const": "deterministic-path-facts" }, "version": { "type": "string" }, "status": { "const": "confirmed" } },
      "additionalProperties": false
    },
    "upstream": {
      "type": "object",
      "required": ["repository", "base", "head", "name_status_sha256"],
      "properties": { "repository": { "type": "string" }, "base": { "type": "string" }, "head": { "type": "string" }, "name_status_sha256": { "$ref": "#/$defs/sha256" } },
      "additionalProperties": false
    },
    "targetSourceSnapshot": {
      "type": "object",
      "required": ["repository", "head", "dirty", "dirty_paths", "dirty_path_manifest_sha256", "source_tree_hash", "inventory_hash", "scope_contract", "hash_algorithm"],
      "properties": {
        "repository": { "type": "string" }, "head": { "type": "string" }, "dirty": { "type": "boolean" },
        "dirty_paths": { "type": "array", "items": { "type": "string" } },
        "dirty_path_manifest_sha256": { "$ref": "#/$defs/sha256" }, "source_tree_hash": { "$ref": "#/$defs/sha256" }, "inventory_hash": { "$ref": "#/$defs/sha256" },
        "scope_contract": { "type": "object", "required": ["source_roots", "excluded_run_outputs"], "properties": { "source_roots": { "type": "array", "items": { "type": "string" } }, "excluded_run_outputs": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
        "hash_algorithm": { "type": "object", "required": ["name", "version"], "properties": { "name": { "const": "sha256" }, "version": { "type": "string" } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "inputRecord": {
      "type": "object",
      "required": ["audit_id", "path", "status", "group_id", "package_id", "surface", "role", "source_facts"],
      "properties": {
        "audit_id": { "type": "string" }, "path": { "type": "string" }, "old_path": { "type": "string" }, "status": { "type": "string" },
        "group_id": { "enum": ["G01", "G02", "G03", "G04", "G05", "G06"] }, "package_id": { "type": ["string", "null"] }, "surface": { "type": "string" }, "role": { "type": "string" },
        "source_facts": { "type": "object" }
      },
      "additionalProperties": false
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
