{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/ce-upstream-sync-run/v1",
  "title": "CE 固定窗口同步运行证据",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "window_sha256",
        "input_sha256",
        "target_snapshot",
        "source_refs",
        "limitations",
        "unresolved",
        "package_id",
        "unit_id",
        "paths",
        "decisions",
        "review_ref",
        "authority_ref",
        "dependency_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "ce-upstream-sync-run/v1"
        },
        "kind": {
          "const": "package-admission"
        },
        "window_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_snapshot": {
          "type": "object"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "unresolved": {
          "type": "array",
          "maxItems": 0
        },
        "package_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "unit_id": {
          "type": "string",
          "pattern": "^U[0-9]+$"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "target_action",
              "rationale"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "target_action": {
                "enum": [
                  "implement-in-current-owner",
                  "compose",
                  "evidence-only",
                  "out-of-scope-by-product-decision"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "review_ref": {
          "type": "string"
        },
        "authority_ref": {
          "type": "string"
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "window_sha256",
        "input_sha256",
        "target_snapshot",
        "source_refs",
        "limitations",
        "unresolved",
        "unit_id",
        "paths",
        "admission_ref",
        "admission_sha256",
        "before_snapshot",
        "changed_files",
        "checks",
        "authorization_scope",
        "claim_ceiling"
      ],
      "properties": {
        "schema_version": {
          "const": "ce-upstream-sync-run/v1"
        },
        "kind": {
          "const": "owner-receipt"
        },
        "window_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_snapshot": {
          "type": "object"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "unresolved": {
          "type": "array",
          "maxItems": 0
        },
        "unit_id": {
          "type": "string",
          "pattern": "^U[0-9]+$"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "admission_ref": {
          "type": "string"
        },
        "admission_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "before_snapshot": {
          "type": "object"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "argv",
              "exit_code",
              "log_path",
              "log_sha256",
              "status",
              "required"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "exit_code": {
                "type": "integer"
              },
              "log_path": {
                "type": "string"
              },
              "log_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not-applicable"
                ]
              },
              "required": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "authorization_scope": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "admission_input_ref": {
          "type": "string"
        },
        "admission_window_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "window_sha256",
        "input_sha256",
        "target_snapshot",
        "source_refs",
        "limitations",
        "unresolved",
        "summary",
        "receipt_refs",
        "freshness",
        "next_owner",
        "claim_ceiling"
      ],
      "properties": {
        "schema_version": {
          "const": "ce-upstream-sync-run/v1"
        },
        "kind": {
          "const": "handoff"
        },
        "window_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_snapshot": {
          "type": "object"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "unresolved": {
          "type": "array",
          "maxItems": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "receipt_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "freshness": {
          "type": "string",
          "minLength": 1
        },
        "next_owner": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
