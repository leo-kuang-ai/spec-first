{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/ce-setup-snapshot/v1",
  "title": "CE setup localization source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "head",
    "dirty",
    "dirty_paths",
    "dirty_path_manifest_sha256",
    "source_tree_hash",
    "inventory_hash",
    "scope_contract",
    "hash_algorithm"
  ],
  "properties": {
    "repository": { "type": "string", "minLength": 1 },
    "head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "dirty": { "type": "boolean" },
    "dirty_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dirty_path_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "source_tree_hash": { "$ref": "#/$defs/sha256" },
    "inventory_hash": { "$ref": "#/$defs/sha256" },
    "scope_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_roots", "excluded_run_outputs"],
      "properties": {
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded_run_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hash_algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "sha256" },
        "version": { "const": "canonical-source-manifest-v1" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
