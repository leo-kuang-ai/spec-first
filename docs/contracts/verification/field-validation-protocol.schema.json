{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-first.dev/contracts/ce-localization-field-validation-protocol/v1",
  "title": "CE localization field validation protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "producer",
    "single_writer",
    "source_snapshot",
    "inventory_ref",
    "inventory_sha256",
    "protocol_id",
    "frozen_at",
    "cohort",
    "task_categories",
    "pairing_rule",
    "complexity_strata",
    "actor_profiles",
    "host_provider_facts",
    "exclusion_rules",
    "minimum_sample",
    "metrics",
    "decision_rule",
    "amendments",
    "overall_status",
    "reason_codes",
    "consumers",
    "limitations",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "ce-localization-field-validation-protocol/v1" },
    "artifact_kind": { "const": "predeclared-field-validation-protocol" },
    "producer": { "const": "ce-localization-field-validation-owner" },
    "single_writer": { "const": "ce-localization-field-protocol-writer" },
    "source_snapshot": { "$ref": "https://spec-first.dev/contracts/ce-setup-snapshot/v1" },
    "inventory_ref": { "type": "string", "minLength": 1 },
    "inventory_sha256": { "$ref": "#/$defs/sha256" },
    "protocol_id": { "type": "string", "pattern": "^FIELD-[A-Z0-9-]+$" },
    "frozen_at": { "type": "string", "format": "date-time" },
    "cohort": { "$ref": "#/$defs/nonEmptyStrings" },
    "task_categories": { "$ref": "#/$defs/nonEmptyStrings" },
    "pairing_rule": { "type": "string", "minLength": 1 },
    "complexity_strata": { "$ref": "#/$defs/nonEmptyStrings" },
    "actor_profiles": { "$ref": "#/$defs/nonEmptyStrings" },
    "host_provider_facts": { "$ref": "#/$defs/nonEmptyStrings" },
    "exclusion_rules": { "$ref": "#/$defs/nonEmptyStrings" },
    "minimum_sample": { "type": "string", "minLength": 1 },
    "metrics": { "$ref": "#/$defs/nonEmptyStrings" },
    "decision_rule": { "type": "string", "minLength": 1 },
    "amendments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "overall_status": { "enum": ["not-run", "active", "complete", "degraded"] },
    "reason_codes": { "$ref": "#/$defs/nonEmptyStrings" },
    "consumers": { "$ref": "#/$defs/nonEmptyStrings" },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
    "claim_ceiling": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
