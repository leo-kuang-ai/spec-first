{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "kind",
    "profile",
    "readiness_status",
    "lifecycle",
    "repo_aligned",
    "capabilities",
    "limitations",
    "source_read_required",
    "fallback",
    "next_actions",
    "native_interfaces",
    "first_generation",
    "steady_state",
    "usage_note"
  ],
  "properties": {
    "schema_version": {
      "const": "provider-readiness.v2"
    },
    "provider": {
      "type": "string"
    },
    "artifact_evidence": {
      "type": "object",
      "required": [
        "schema_version",
        "verified_at",
        "repo_root",
        "query_verified",
        "source_snapshot",
        "provider_identity",
        "files"
      ],
      "properties": {
        "schema_version": {
          "const": "codegraph-artifact-evidence.v1"
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "repo_root": {
          "type": "string",
          "minLength": 1
        },
        "query_verified": {
          "const": true
        },
        "source_snapshot": {
          "$ref": "#/properties/first_generation/properties/scope_provenance/properties/source_snapshot"
        },
        "provider_identity": {
          "allOf": [
            {
              "$ref": "#/properties/provider_identity"
            },
            {
              "required": [
                "installer",
                "inventory_sha256"
              ],
              "properties": {
                "installer": {
                  "const": "npm"
                },
                "inventory_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "files": {
          "type": "object",
          "required": [
            "codegraph.db",
            "codegraph.db-wal",
            "codegraph.db-journal"
          ],
          "properties": {
            "codegraph.db": {
              "type": "object",
              "required": [
                "size_bytes",
                "sha256"
              ],
              "properties": {
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            },
            "codegraph.db-wal": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "size_bytes",
                    "sha256"
                  ],
                  "properties": {
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "codegraph.db-journal": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "size_bytes",
                    "sha256"
                  ],
                  "properties": {
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provider_identity": {
      "type": "object",
      "required": ["package", "version", "command"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "interpreter": { "type": ["string", "null"] },
        "installer": { "type": ["string", "null"] },
        "inventory_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "code-structure",
        "project-graph",
        "memory",
        "generic"
      ]
    },
    "profile": {
      "enum": [
        "minimal",
        "optional",
        "recommended",
        "platform"
      ]
    },
    "readiness_status": {
      "enum": [
        "fresh",
        "stale",
        "degraded",
        "not-run",
        "unknown"
      ]
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "installed",
        "configured",
        "initialized",
        "indexed",
        "server_reachable",
        "artifact_exists",
        "query_verified",
        "fallback_used"
      ],
      "properties": {
        "installed": {
          "type": "boolean"
        },
        "configured": {
          "type": "boolean"
        },
        "initialized": {
          "type": "boolean"
        },
        "indexed": {
          "type": "boolean"
        },
        "server_reachable": {
          "type": "boolean"
        },
        "artifact_exists": {
          "type": "boolean"
        },
        "query_verified": {
          "type": "boolean"
        },
        "fallback_used": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "repo_aligned": {
      "enum": [
        "yes",
        "no",
        "unknown",
        "not-applicable"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_read_required": {
      "type": "boolean"
    },
    "fallback": {
      "type": "object",
      "required": [
        "available",
        "methods",
        "reason_code"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_code": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "native_interfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "first_generation": {
      "type": "object",
      "required": [
        "owner",
        "status",
        "scope",
        "requires_explicit_gate",
        "requirement_workspace_path",
        "artifact_root"
      ],
      "properties": {
        "owner": {
          "enum": [
            "runtime-setup",
            "provider-native",
            "user",
            "none",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "not-run",
            "failed",
            "skipped",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "project",
            "run-scoped-workspace",
            "user-specified",
            "not-applicable",
            "unknown"
          ]
        },
        "requires_explicit_gate": {
          "type": "boolean"
        },
        "requirement_workspace_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_provenance": {
          "type": "object",
          "required": [
            "status",
            "reason_code",
            "requested_requirement_workspace_path",
            "verified_requirement_workspace_path",
            "receipt_ref"
          ],
          "properties": {
            "graph_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "source_kind", "source_content_sha256"],
              "properties": {
                "schema_version": { "const": "setup-source-snapshot.v2" },
                "source_kind": { "enum": ["git", "folder"] },
                "source_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            },
            "source_reason_code": {
              "enum": ["graphify-source-changed-during-generation", "graphify-source-snapshot-unavailable"]
            },
            "status": {
              "enum": [
                "verified",
                "missing",
                "mismatch",
                "invalid",
                "unknown"
              ]
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "requested_requirement_workspace_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified_requirement_workspace_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "receipt_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "steady_state": {
      "type": "object",
      "required": [
        "refresh_owner",
        "refresh_mode",
        "hook_default",
        "usage_owner"
      ],
      "properties": {
        "refresh_owner": {
          "enum": [
            "provider-native",
            "runtime-setup",
            "user",
            "none",
            "unknown"
          ]
        },
        "refresh_mode": {
          "enum": [
            "watcher",
            "skill-cli-hook-on-demand",
            "cli-mcp-hook-on-demand",
            "commit-hook-external-verified",
            "commit-hook-spec-first-async",
            "manual-only",
            "none",
            "unknown"
          ]
        },
        "hook_default": {
          "type": "boolean"
        },
        "usage_owner": {
          "enum": [
            "downstream-skill",
            "provider-native",
            "user",
            "none",
            "unknown"
          ]
        },
        "hook_installed": {
          "type": "boolean"
        },
        "hook_verified": {
          "type": "boolean"
        },
        "hook_status": {
          "enum": [
            "verified",
            "verified-external",
            "installed",
            "failed",
            "blocked",
            "skipped",
            "unknown"
          ]
        },
        "hook_skipped_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "usage_note": {
      "type": "string"
    },
    "readiness_scope": {
      "enum": [
        "installation",
        "artifact"
      ]
    }
  },
  "additionalProperties": false
}
