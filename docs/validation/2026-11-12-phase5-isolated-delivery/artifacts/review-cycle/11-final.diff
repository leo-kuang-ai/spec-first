+test('GET /entries?month=YYYY-MM 按条目的 ts 逐条筛选，未命中的月份返回空数组（AE4）', async () => {
+  await withServer(async (baseUrl) => {
+    // 三个月跨度、两个不同月份交错录入，硬编码期望集合：
+    // 若实现把「月份匹配」做成「首条月份相同就返回全量、否则返回空」（全有/全无），
+    // 或忽略 month 参数，下面的精确集合断言都会失败。
+    await seedAt(baseUrl, [
+      { amount: 1, note: 'jan-a', ts: Date.UTC(2025, 0, 15, 12) },
+      { amount: 2, note: 'feb', ts: Date.UTC(2025, 1, 10, 12) },
+      { amount: 3, note: 'jan-b', ts: Date.UTC(2025, 0, 20, 12) },
+    ]);
+
+    const pick = (list) => list.map((e) => ({ id: e.id, amount: e.amount, note: e.note }));
+
+    assert.deepEqual(pick(await listEntries(baseUrl, '?month=2025-01')), [
+      { id: 1, amount: 1, note: 'jan-a' },
+      { id: 3, amount: 3, note: 'jan-b' },
+    ]);
+    assert.deepEqual(pick(await listEntries(baseUrl, '?month=2025-02')), [
+      { id: 2, amount: 2, note: 'feb' },
+    ]);
+    assert.deepEqual(await listEntries(baseUrl, '?month=2025-03'), []);
+
+    // 全量列表不受 month 影响，且顺序为录入顺序
+    assert.deepEqual(pick(await listEntries(baseUrl)), [
+      { id: 1, amount: 1, note: 'jan-a' },
+      { id: 2, amount: 2, note: 'feb' },
+      { id: 3, amount: 3, note: 'jan-b' },
+    ]);
+  });
+});
